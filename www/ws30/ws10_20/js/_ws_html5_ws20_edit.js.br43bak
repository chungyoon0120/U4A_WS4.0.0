    // SAP 아이콘 키 → <img src> (구 fnGetSapIconPath + 트리와 동일한 file:// 변환).
    function _iconSrc(sKey) {
        if (!sKey) { return ""; }
        var p = "";
        try { p = oAPP.fn.fnGetSapIconPath(sKey) || ""; } catch (e) { }
