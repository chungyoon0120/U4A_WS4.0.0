/************************************************************************
 * OTRF4HelpPopup/frame.css — 외부 셸(공통 타이틀바/iframe/로더) 레이아웃.
 * 타이틀바(.u4a-titlebar/.u4a-winbtn)는 shell.css+bootstrap-skin.css 공통 소유.
 * 색·radius·shadow 는 theme/tokens.css 의미 토큰만 소비(하드코딩 0).
 ************************************************************************/

html,
body {
    height: 100%;
}

body {
    margin: 0;
    overflow: hidden;
    /* 타이틀바(고정) + 본문(가변) 세로 스택 */
    display: flex;
    flex-direction: column;
    background: var(--boot-bg, var(--app-bg));
    color: var(--text);
    font-family: var(--font);
    /* 부모 창 위에서 가장자리가 또렷하게 보이도록 내부 테두리 링(레이아웃 영향 없음) */
    box-shadow: inset 0 0 0 0.0625rem var(--line);
}

/* 공통 타이틀바는 flex 컬럼에서 높이 고정(세로 압박에도 안 줄게) */
.u4a-titlebar {
    flex: 0 0 auto;
}

/* ── 본문 = iframe(검색폼/결과 테이블) ─────────────────────────────── */
/* 등장 효과: 처음 opacity:0 → F4 로딩 완료 시 .u4aOtrShown 으로 스르르 페이드인.
   ★네이티브 창 opacity(무거움·흰 플래시) 대신 DOM CSS transition(GPU 합성). editorPopup 동일. */
#otrContent {
    flex: 1 1 auto;
    position: relative;
    min-height: 0;
    background: var(--app-bg);
    opacity: 0;
    transition: opacity 0.3s linear;
}

#otrContent.u4aOtrShown {
    opacity: 1;
}

@media (prefers-reduced-motion: reduce) {
    #otrContent { transition: none; }
}

#ws_frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    overflow: hidden;
}

/* ── 로딩 오버레이 = 공통 .u4a-busy(shell.css SSOT — 카드+이중링 스피너, data-busy 토글, 0.3s 지연).
   화면별 로더(u4a_loaders/cl_ring) CSS 제거 — frame.html 이 .u4a-busy 소비. ── */
