/****************************************************************************
 * Find(찾기) 창 — 스코프 스타일
 * --------------------------------------------------------------------------
 *  창 골격 = [공통 .u4a-titlebar] + [본체(좌측 네비 + 우측 모드 콘텐츠)].
 *  원본: sap.tnt.ToolPage(SideNavigation + NavContainer).
 *  HTML5(다듬기): 좌 네비(공통 .u4a-navlist 톤, 건수 배지) | 세로 divider | 우 콘텐츠
 *  (모드별 카드헤더 + 검색툴바 + 공통 .u4a-table). M002 만 좌우 .u4a-splitter(두 테이블).
 *  ★ 여백 0(풀블리드) — 타이틀바 바로 아래부터 창 가장자리까지 꽉 채운다(카드 띄움 금지).
 *  ★ 모드 전환 = 공통 페이지전환(.analy/16 §9.2) 화면 스코프 복제(슬라이드+페이드, 겹침 방지).
 *  ★ 반응형(Chromium93 컨테이너쿼리 미지원 → findFrame.js 가 ResizeObserver 로 폭 클래스 토글):
 *     좌 네비는 항상 좌측 고정(폭만 축소), 우측만 접힘(M002 분할→세로, 테이블→카드뷰).
 *  색/모양은 theme 토큰만 소비(하드코딩 없음). 공통 .u4a-btn/.u4a-field/.u4a-table/.u4a-titlebar/
 *  .u4a-splitter/.u4a-navlist/.u4a-dialog/.u4a-busy/.u4a-toast 를 소비하고, 여기 규칙은 이 창 전용 레이아웃만.
 ****************************************************************************/

html,
body {
    height: 100%;
}

/* 링크 클릭/새로고침 등 사용자 액션 busy 는 즉시 표시 — 공통 .u4a-busy 의 0.3s 지연은
   "짧은 자동 busy 깜빡임 방지"용이라, 사용자가 트리거한 서버 왕복(트리 이동/컨트롤러 실행)에서는
   응답이 빠르면 스피너가 뜨기도 전에 꺼져 "busy 가 안 돈다"로 보인다. 스코프 override 로 지연 제거.
   (특이도: #findBusy[data-busy] = (1,1,0) 가 공통 .u4a-busy[data-busy] = (0,2,0) 를 이긴다.) */
#findBusy[data-busy="true"] {
    transition: opacity 0.12s linear 0s, visibility 0s linear 0s;
}

body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--boot-bg, var(--app-bg));
    color: var(--text);
}

/* ===== 본체 = 여백 0(풀블리드) 공통 스플리터 = 네비 | 세로바 | 메인 ===== */
.u4aFindBody {
    flex: 1 1 auto;
    box-sizing: border-box;
    display: flex;
    min-height: 0;
    min-width: 0;
    /* 데이터 도착 전엔 숨김 → _finishOpen 에서 페이드 인(흰 번쩍 방지). */
    opacity: 0;
    transition: opacity 0.25s ease;
}

.u4aFindShown {
    opacity: 1;
}

.u4aFindSplit {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
}

/* 네비 팬(초기 폭 clamp — 항상 좌측 고정, 바 드래그로 조절).
   min-width: 공통 wireSplitter 의 최소폭 단일출처(clamp 하한과 일치 → 드래그해도 8.5rem 이하로 안 줄어듦). */
.u4aFindNavPane {
    flex: 0 0 clamp(8.5rem, 22%, 15rem);
    display: flex;
    min-width: 8.5rem;
    overflow: hidden;
}

/* 메인 팬 — 남은 폭 채움. min-width 를 넉넉히 줘서 스플릿바로 우측을 궤멸시켜
   카드헤더/검색/오버플로 버튼이 화면 밖으로 사라지는 것을 막는다. */
.u4aFindMainPane {
    flex: 1 1 auto;
    display: flex;
    min-width: 20rem;
    overflow: hidden;
}

/* ── 좌측 네비(공통 .u4a-navlist) = 풀높이 패널(카드 아님, 우측 divider 로만 구분) ── */
.u4aFindNav {
    flex: 1 1 auto;
    box-sizing: border-box;
    padding: 0.375rem 0;
    overflow: auto;
    background: var(--surface);
    border-right: 0.0625rem solid var(--divider);
}

/* 네비 항목 우측 건수 배지 — 선택 시 accent, 0 이면 흐리게. (숫자만: 언어 무관)
   ★ 공통 .u4a-navlist__item > span{flex:1 1 auto}(shell) 을 이기려 자식결합자로 특이도 확보. */
.u4a-navlist__item > .u4aFindNav__cnt {
    flex: 0 0 auto;
    min-width: 1.4rem;
    height: 1.25rem;
    padding: 0 0.45rem;
    border-radius: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    background: var(--hover-bg);
    color: var(--text-muted);
    overflow: visible;
}

.u4a-navlist__item[aria-selected="true"] > .u4aFindNav__cnt {
    background: var(--accent);
    color: #fff;
}

.u4a-navlist__item > .u4aFindNav__cnt[data-zero="true"] {
    opacity: 0.5;
}

/* ── 우측 메인 = 풀높이 패널(카드 아님). 안에 모드 페이지가 슬라이드 전환된다. ── */
.u4aFindMain {
    flex: 1 1 auto;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--surface);
}

/* ── 모드 페이지(슬라이드 전환 레이어) — 불투명 배경으로 이전 페이지 비침 차단 ── */
.u4aFindPage {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--surface);
}

/* 전환 사양 = 16 §9.2 고정값(0.26s ease both / translateX(±32px) + opacity / 들어오는 페이지 z-index:2).
   별창이라 ws20.css(.u4aWsNav*)가 없으므로 §9.5 에 따라 스코프로 복제한다. 모드 페이지·M002 팬 페이지 공용. */
@keyframes u4aFindInFwd {
    from { opacity: 0; transform: translateX(32px); }
    to   { opacity: 1; transform: none; }
}
@keyframes u4aFindInBack {
    from { opacity: 0; transform: translateX(-32px); }
    to   { opacity: 1; transform: none; }
}
@keyframes u4aFindOutFwd {
    from { opacity: 1; transform: none; }
    to   { opacity: 0; transform: translateX(-32px); }
}
@keyframes u4aFindOutBack {
    from { opacity: 1; transform: none; }
    to   { opacity: 0; transform: translateX(32px); }
}

.u4aFindPage--inFwd   { animation: u4aFindInFwd 0.26s ease both; z-index: 2; }
.u4aFindPage--inBack  { animation: u4aFindInBack 0.26s ease both; z-index: 2; }
.u4aFindPage--outFwd  { animation: u4aFindOutFwd 0.26s ease both; z-index: 1; }
.u4aFindPage--outBack { animation: u4aFindOutBack 0.26s ease both; z-index: 1; }

@media (prefers-reduced-motion: reduce) {
    .u4aFindPage--inFwd,
    .u4aFindPage--inBack,
    .u4aFindPage--outFwd,
    .u4aFindPage--outBack,
    .u4aFindPane--inFwd,
    .u4aFindPane--inBack,
    .u4aFindPane--outFwd,
    .u4aFindPane--outBack { animation: none; }
}

/* ── 카드 헤더(모드 아이콘 + 제목 + 건수 칩 + 도움말/새로고침) ── */
.u4aFindHead {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border-bottom: 0.0625rem solid var(--divider);
}

.u4aFindHead__ico {
    flex: 0 0 auto;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--selected-bg);
    color: var(--accent);
}

/* 제목 — 최대 2줄까지 표시 후 말줄임(장군님 지시). 2줄 초과 시 공통 툴팁(세로 잘림도 검사).
   flex:0 1 auto — 남은 공간은 actions(overflow 컨테이너)가 흡수해야 복구되므로 제목은 흡수하지 않는다. */
.u4aFindHead__title {
    flex: 0 1 auto;
    min-width: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.25;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
}

.u4aFindHead__chip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.6rem;
    border-radius: 1rem;
    font-size: 0.74rem;
    font-weight: 600;
    background: var(--selected-bg);
    color: var(--selected-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
}

/* 액션 클러스터(도움말·새로고침) — 공통 U4AUI.attachOverflow 대상(§11). 좁으면 ⋯ 로 접힘.
   ★ [hidden] override 필수 — .u4a-btn-icon 은 display:inline-flex 라 UA [hidden]{display:none} 을
     특이도로 이겨(안 접힘) → 명시적으로 숨긴다(attachoverflow-needs-hidden-override). */
.u4aFindHead__actions {
    /* ★ 가용폭 흡수(flex-grow:1) — 접힌 뒤 스플릿바로 넓히면 폭이 늘어 attachOverflow 가 복구(펼침)한다.
       flex:0 * auto(콘텐츠폭)면 접힌 상태에서 폭이 안 늘어 영영 복구되지 않는다(공통 헤더 .u4a-ws10__common 패턴 동일). */
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    overflow: hidden;
}

.u4aFindHead__actions > [hidden] {
    display: none !important;
}

/* ── 모드 본문(단일 팬 / 좌우 분할) ─────────────────────────────────────── */
.u4aFindMode {
    flex: 1 1 auto;
    display: flex;
    min-height: 0;
    min-width: 0;
}

/* 분할 모드(M002): .u4a-splitter 소비 — 좌우 50/50 초기.
   ★ min-width: 각 팬이 스플릿바 드래그로 무한정 좁아져 검색/툴바가 깨지지 않게 하한 확보. */
.u4aFindMode.u4a-splitter > .u4a-splitter__pane {
    flex: 1 1 50%;
    display: flex;
    flex-direction: column;
    min-width: 13rem;
    min-height: 0;
    overflow: hidden;
}
/* ★ 좌팬 = 드래그 대상(grow:0 → 공통 wireSplitter 가 "고정 조절" 판정) / 우팬 = 유연 흡수(grow:1).
   둘 다 grow>0(유연)이면 드래그 시 양쪽 다 flex:0 0 px 로 고정돼, 최대화 때 재클램프(iNeed<=0)가
   무처리라 우측이 빈다. 좌팬만 고정되게 나눠 우팬이 최대화 시 늘어나게 한다. */
.u4aFindMode.u4a-splitter > .u4a-splitter__pane:first-child {
    flex: 0 1 50%;
}

/* ── 팬(검색툴바 + 테이블) ──────────────────────────────────────────────── */
.u4aFindPane {
    flex: 1 1 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

/* 검색 툴바 — [M002 제목][스페이서][검색]. 아래 구분선. min-width:0 로 자식 축소 허용.
   ★ 좁으면 검색이 먼저 공통 attachOverflow 로 ⋯ 접힘(제목 유지), 더 좁으면 제목 말줄임(장군님 지시). */
.u4aFindPane__toolbar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    overflow: hidden;
    padding: 0.6rem 1rem;
    border-bottom: 0.0625rem solid var(--divider);
}

/* 검색 오버플로 컨테이너 — 남은 폭 흡수(제목 제외한 우측 전체). 이 안의 검색만 attachOverflow 로 접힌다. */
.u4aFindSearchOvf {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    gap: 0.25rem;
}

/* attachOverflow [hidden] override — 접힌 검색/⋯가 확실히 숨겨지게(inline-flex [hidden] 함정). */
.u4aFindSearchOvf > [hidden] {
    display: none !important;
}

/* M002 좌/우 라벨(원본 아이콘+텍스트: Properties/Aggregations).
   ★ 좁으면 라벨이 검색을 밀지 않도록 축소(flex:0 1 auto) → 텍스트 말줄임(+공통 툴팁).
     단 min-width 로 최소폭을 확보해, 아무리 좁아도 제목이 완전히 사라지지 않고 "..."로라도 보이게 한다(장군님 지시). */
.u4aFindPane__headlabel {
    flex: 0 1 auto;
    min-width: 4.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
}

.u4aFindPane__headlabel > i {
    flex: 0 0 auto;
    opacity: 0.85;
}

/* 라벨 텍스트만 말줄임(아이콘은 유지). 잘리면 headlabel 의 data-tip-trunc-sel="span" 이 공통 툴팁 표시. */
.u4aFindPane__headlabel > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
}

/* ⋯ 오버플로 메뉴 안에 접힌 검색 — 메뉴 폭 확보 + 검색 필드 풀폭. */
.u4aFindSearchMenuRow {
    padding: 0.25rem;
    min-width: 15rem;
}
.u4aFindSearchMenuRow .u4a-field {
    width: 100%;
}

/* 검색바 — 좁으면 ⋯로 접히는 대상(attachOverflow). 기본 폭 18rem, 축소 하한 8rem, 그 이하는 ⋯ 로.
   (단일모드 팬은 attachOverflow 미적용이라 flex:1 로 폭을 채운다 — .u4aFindPane--single 참고.) */
/* M002 검색 — oSrchOvf 안에서 고정폭(14rem). oSrchOvf 폭이 이보다 좁아지면 attachOverflow 가 ⋯ 로 접는다. */
.u4aFindSearch {
    flex: 0 0 auto;
    width: 14rem;
}
/* 단일 모드(M001/M003/M004/M005) 팬 — 툴바에 제목 없이 검색만. 검색이 폭을 채운다. */
.u4aFindPane--single .u4aFindSearch {
    flex: 1 1 auto;
    width: auto;
    min-width: 6rem;
}

.u4aFindSearch .u4a-field {
    width: 100%;
}

/* 테이블 래퍼 — 남은 높이 채우고 세로 스크롤만(가로 스크롤 금지, 좁으면 카드뷰로 대체). 장군님 지시. */
.u4aFindWrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
}

/* 링크 셀(원본 sap.m.Link emphasized) — 굵게 + accent. */
.u4aFindLink {
    color: var(--accent);
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
}

.u4aFindLink:hover {
    text-decoration: underline;
}

/* ══════════ 반응형 (findFrame.js 가 .u4aFindMain 에 data-w="narrow" 토글) ══════════ */
/* 좁을 때 = 원본 sap.ui.layout.ResponsiveSplitter 의 페이지 모드 재현(index.js fnGetFindPage2).
   폭이 SplitPane.requiredParentWidth(기본 800px) 미만이면 두 팬이 각각 별도 페이지가 되어
   한 번에 하나만 보이고, 하단 페이지 도트로 좌/우 페이지를 오간다. (세로 스택 아님) */
.u4aFindMain[data-w="narrow"] .u4aFindMode.u4a-splitter > .u4a-splitter__bar {
    display: none;
}
/* 팬을 겹쳐 두어야 페이지 전환 슬라이드(§9.5)가 가능하다. 불투명 배경 = 이전 팬 비침 차단. */
.u4aFindMain[data-w="narrow"] .u4aFindMode.u4a-splitter {
    position: relative;
}
/* ★ !important 필수 — 스플릿바를 드래그했으면 공통 wireSplitter 가 팬에 인라인 flex:0 0 <px> 를 남긴다.
   인라인은 특이도와 무관하게 스타일시트를 이기므로, !important 없이는 페이지 모드에서 팬이 그 고정 px
   (예: 300px)에 갇혀 나머지가 빈다. 페이지 모드는 한 팬이 폭 전체를 차지해야 한다. */
.u4aFindMain[data-w="narrow"] .u4aFindMode.u4a-splitter > .u4a-splitter__pane {
    position: absolute;
    inset: 0;
    background: var(--surface);
    flex: 1 1 auto !important;
    min-width: 0;                 /* 한 팬만 노출 → 가로 하한 해제(극단 폭 대응) */
    display: none;                /* 비활성 페이지 숨김 */
}
/* 활성 페이지(findFrame.js 가 data-page 로 토글)만 표시. */
.u4aFindMain[data-w="narrow"] .u4aFindMode.u4a-splitter[data-page="0"] > .u4a-splitter__pane:first-child,
.u4aFindMain[data-w="narrow"] .u4aFindMode.u4a-splitter[data-page="1"] > .u4a-splitter__pane:last-child {
    display: flex;
}

/* 페이지 전환 중인 팬 — 나가는 팬도 애니메이션 동안은 보여야 하므로 display 를 되살린다(§9.3). */
.u4aFindMain[data-w="narrow"] .u4aFindMode.u4a-splitter > .u4aFindPane--inFwd,
.u4aFindMain[data-w="narrow"] .u4aFindMode.u4a-splitter > .u4aFindPane--inBack,
.u4aFindMain[data-w="narrow"] .u4aFindMode.u4a-splitter > .u4aFindPane--outFwd,
.u4aFindMain[data-w="narrow"] .u4aFindMode.u4a-splitter > .u4aFindPane--outBack {
    display: flex;
}

.u4aFindPane--inFwd   { animation: u4aFindInFwd 0.26s ease both; z-index: 2; }
.u4aFindPane--inBack  { animation: u4aFindInBack 0.26s ease both; z-index: 2; }
.u4aFindPane--outFwd  { animation: u4aFindOutFwd 0.26s ease both; z-index: 1; }
.u4aFindPane--outBack { animation: u4aFindOutBack 0.26s ease both; z-index: 1; }

/* ── 페이지 도트(원본 ResponsiveSplitter 하단 페이지네이터) — 좁을 때만 노출 ───────── */
.u4aFindPager {
    display: none;
}
.u4aFindMain[data-w="narrow"] .u4aFindPager {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.25rem 0;
    border-top: 0.0625rem solid var(--divider);
}

/* ★ 히트영역 = 2.25rem 정사각(터치/마우스 모두 충분). 점은 ::after 로 작게 그리고,
   버튼 자체는 투명한 넓은 클릭 표적 — 점 크기만 키우면 디자인이 깨지므로 표적만 키운다. */
.u4aFindPager__dot {
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.u4aFindPager__dot::after {
    content: "";
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--text-muted);
    opacity: 0.45;
    transition: background var(--motion, .15s) linear, opacity var(--motion, .15s) linear;
}

.u4aFindPager__dot:hover {
    background: var(--hover-bg);
}

.u4aFindPager__dot:hover::after {
    opacity: 0.75;
}

.u4aFindPager__dot--on::after {
    background: var(--accent);
    opacity: 1;
}

/* ── M005 도움말 모달 — 공통 .u4a-dialog 소비 + 스코프 사이즈 ──────────────── */
.u4aFindHelpDlg {
    width: 70vw;
    height: 70vh;
    max-width: 60rem;
    padding: 0;
}

.u4aFindHelpDlg .u4aFindHelpBody {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
}

.u4aFindHelpDlg .u4aFindHelpFrame {
    width: 100%;
    height: 100%;
    border: none;
    background: var(--surface);
}
