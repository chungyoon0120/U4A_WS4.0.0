# --- SAP system connection (required) ---
# Base URL of the SAP system's ADT/ICF endpoint, including scheme and port.
# Example: https://my-sap-host.corp.com:44300
SAP_ADT_HOST=https://uha.u4aide.com:10101

# SAP client (mandant), e.g. 100. Optional but usually required.
SAP_ADT_CLIENT=800

# Logon language for descriptions/messages (2-letter ISO). Default: EN
SAP_ADT_LANGUAGE=EN

# --- Authentication: choose ONE method ---

# Method A: Basic auth (most common for ADT)
SAP_ADT_USER=SOCCERHS
SAP_ADT_PASSWORD=cjddbs12

# Method B: OAuth / Bearer token (BTP / SSO). If set, this takes precedence
# over Basic auth above.
# SAP_ADT_TOKEN=eyJhbGciOi...

# --- TLS / networking ---
# Set to "false" to skip TLS certificate verification (dev systems with
# self-signed certs only). Default: true
SAP_ADT_VERIFY_SSL=false

# Request timeout in seconds. Default: 60
SAP_ADT_TIMEOUT=60

# Default ATC check variant used by sap_adt_run_atc when none is supplied.
# Default: DEFAULT
SAP_ADT_ATC_VARIANT=DEFAULT
